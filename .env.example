# EduFinSight (GradGuide Education Loan Assessment Tool)
# Environment Configuration Template

# Backend Environment
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secure_jwt_secret_gradguide_2026_change_in_production
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL - Neon, Supabase, Render, or Local)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edufinsight?schema=public

# Upload Storage Directory
UPLOAD_DIR=./uploads

# Frontend Environment (Vite)
# In production, set this to the deployed backend URL (e.g. https://edufinsight-api.onrender.com)
VITE_API_URL=http://localhost:5000/api
